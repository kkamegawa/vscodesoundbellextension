{
  "name": "sound-notifier-for-copilot-agent-task",
  "displayName": "Sound Notifier for GitHub Copilot Agent task",
  "description": "Play sounds when GitHub Copilot agent completes tasks",
  "version": "0.0.2",
  "publisher": "KazushiKamegawa",
  "license": "MIT",
  "homepage": "https://github.com/kkamegawa/vscodesoundbellextension",
  "bugs": {
    "url": "https://github.com/kkamegawa/vscodesoundbellextension/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kkamegawa/vscodesoundbellextension"
  },
  "engines": {
    "vscode": "^1.146.0",
    "node": ">=24.0.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "copilot",
    "sound",
    "notification",
    "agent",
    "completion",
    "accessibility",
    "productivity"
  ],
  "galleryBanner": {
    "color": "#0078d4",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "KazushiKamegawa.sound-notifier-audio-client"
  ],
  "icon": "media/icon/task-complete-icon.png",
  "contributes": {
    "commands": [
      {
        "command": "soundNotifier.playSound",
        "title": "Play Completion Sound",
        "category": "Sound Notifier for Agent task"
      },
      {
        "command": "soundNotifier.testSound",
        "title": "Test Sound",
        "category": "Sound Notifier for Agent task"
      },
      {
        "command": "soundNotifier.toggleVSCodeNotification",
        "title": "Toggle VS Code Completion Notification",
        "category": "Sound Notifier for Agent task"
      },
      {
        "command": "soundNotifier.installAgentStopHook",
        "title": "Install Copilot Agent Completion Hook",
        "category": "Sound Notifier for Agent task"
      },
      {
        "command": "soundNotifier.uninstallAgentStopHook",
        "title": "Uninstall Copilot Agent Completion Hook",
        "category": "Sound Notifier for Agent task"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node scripts/clean-generated.js",
    "compile": "npm run clean && tsc -p ./ && npm run compile:audio",
    "compile:audio": "tsc -p local-audio-host/tsconfig.json",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src local-audio-host/src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test:unit": "mocha out/test/suite/*.test.js",
    "package": "vsce package && npm run package:audio",
    "package:audio": "node scripts/package-audio.js",
    "publish": "npm run publish:audio && vsce publish",
    "publish:audio": "node scripts/package-audio.js --publish-marketplace",
    "publish:ovsx": "npm run publish:ovsx:audio && npx ovsx publish",
    "publish:ovsx:audio": "node scripts/package-audio.js --publish-open-vsx"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.146.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "glob": "^14.0.6",
    "mocha": "^12.0.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  }
}
