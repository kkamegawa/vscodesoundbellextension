# VS Code ignore patterns for packaging

# Source files
src/**/*.ts
test/**
.vscode-test/**

# Build/tooling files
node_modules/**
.github/**
.git/**
.gitignore
tsconfig.json
.eslintrc.json
eslint.config.js
webpack.config.js
.vscode/**
local-audio-host/**
scripts/**
!scripts/copilot-agent-stop.cjs

# Development files
*.map
*.ts

# Documentation (keep only essential)
RELEASE.md
SECURITY.md

# Test and development files
test-sound.js
*.log
*.pid
*.seed
*.coverage
.nyc_output

# OS files
.DS_Store
Thumbs.db

# Include essential files
!README.md
!CHANGELOG.md
!LICENSE
!icon.png
!package.json
out/test/**
